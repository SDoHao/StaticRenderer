<?xml version="1.0" encoding="UTF-8"?>
<scene>
    <!-- 马路与小汽车场景 -->
    <!-- 摄像机: 从右前方斜上方俯瞰 -->
    <camera position="3,2,10" target="0,0.5,3" up="0,1,0" fov="60" near="0.1" far="1000"/>

    <!-- ==================== 地面 ==================== -->
    <sceneobject position="0,0,3" euler="-90,0,0" scale="10.0">
        <disk radius="1.0"/>
    </sceneobject>

    <!-- ==================== 路面 (灰色柏油路, 高于地面 0.01 避免 Z-fighting) ==================== -->
    <sceneobject position="0,0.01,0" euler="0,0,0" scale="1.0">
        <triangle v0="-2,0,-2" v1="2,0,8" v2="2,0,-2"/>
        <triangle v0="-2,0,-2" v1="-2,0,8" v2="2,0,8"/>
    </sceneobject>

    <!-- ==================== 路面中线 (虚线, 高于路面 0.005) ==================== -->
    <sceneobject position="0,0.015,0" euler="0,0,0" scale="1.0">
        <!-- z=0 -->
        <triangle v0="-0.06,0.005,-0.3" v1="0.06,0.005,0.3" v2="0.06,0.005,-0.3"/>
        <triangle v0="-0.06,0.005,-0.3" v1="-0.06,0.005,0.3" v2="0.06,0.005,0.3"/>
        <!-- z=1.5 -->
        <triangle v0="-0.06,0.005,1.2" v1="0.06,0.005,1.8" v2="0.06,0.005,1.2"/>
        <triangle v0="-0.06,0.005,1.2" v1="-0.06,0.005,1.8" v2="0.06,0.005,1.8"/>
        <!-- z=4.5 -->
        <triangle v0="-0.06,0.005,4.2" v1="0.06,0.005,4.8" v2="0.06,0.005,4.2"/>
        <triangle v0="-0.06,0.005,4.2" v1="-0.06,0.005,4.8" v2="0.06,0.005,4.8"/>
        <!-- z=6.0 -->
        <triangle v0="-0.06,0.005,5.7" v1="0.06,0.005,6.3" v2="0.06,0.005,5.7"/>
        <triangle v0="-0.06,0.005,5.7" v1="-0.06,0.005,6.3" v2="0.06,0.005,6.3"/>
    </sceneobject>

    <!-- ==================== 车身 (长方体 6面×2三角形) ==================== -->
    <sceneobject position="0,0.8,3" euler="0,0,0" scale="1.0">
        <!-- 前面 (z=+1.2) -->
        <triangle v0="-0.6,-0.3,1.2" v1="0.6,-0.3,1.2" v2="0.6,0.3,1.2"/>
        <triangle v0="-0.6,-0.3,1.2" v1="0.6,0.3,1.2" v2="-0.6,0.3,1.2"/>
        <!-- 后面 (z=-1.2) -->
        <triangle v0="0.6,-0.3,-1.2" v1="-0.6,-0.3,-1.2" v2="-0.6,0.3,-1.2"/>
        <triangle v0="0.6,-0.3,-1.2" v1="-0.6,0.3,-1.2" v2="0.6,0.3,-1.2"/>
        <!-- 左面 (x=-0.6) -->
        <triangle v0="-0.6,-0.3,-1.2" v1="-0.6,-0.3,1.2" v2="-0.6,0.3,1.2"/>
        <triangle v0="-0.6,-0.3,-1.2" v1="-0.6,0.3,1.2" v2="-0.6,0.3,-1.2"/>
        <!-- 右面 (x=0.6) -->
        <triangle v0="0.6,-0.3,1.2" v1="0.6,-0.3,-1.2" v2="0.6,0.3,-1.2"/>
        <triangle v0="0.6,-0.3,1.2" v1="0.6,0.3,-1.2" v2="0.6,0.3,1.2"/>
        <!-- 顶面 (y=0.3) -->
        <triangle v0="-0.6,0.3,1.2" v1="0.6,0.3,1.2" v2="0.6,0.3,-1.2"/>
        <triangle v0="-0.6,0.3,1.2" v1="0.6,0.3,-1.2" v2="-0.6,0.3,-1.2"/>
        <!-- 底面 (y=-0.3) -->
        <triangle v0="-0.6,-0.3,-1.2" v1="0.6,-0.3,-1.2" v2="0.6,-0.3,1.2"/>
        <triangle v0="-0.6,-0.3,-1.2" v1="0.6,-0.3,1.2" v2="-0.6,-0.3,1.2"/>
    </sceneobject>

    <!-- ==================== 车顶/驾驶舱 (长方体 6面×2三角形) ==================== -->
    <sceneobject position="0,1.35,2.7" euler="0,0,0" scale="1.0">
        <!-- 前面 (z=+0.6) -->
        <triangle v0="-0.5,-0.25,0.6" v1="0.5,-0.25,0.6" v2="0.5,0.25,0.6"/>
        <triangle v0="-0.5,-0.25,0.6" v1="0.5,0.25,0.6" v2="-0.5,0.25,0.6"/>
        <!-- 后面 (z=-0.6) -->
        <triangle v0="0.5,-0.25,-0.6" v1="-0.5,-0.25,-0.6" v2="-0.5,0.25,-0.6"/>
        <triangle v0="0.5,-0.25,-0.6" v1="-0.5,0.25,-0.6" v2="0.5,0.25,-0.6"/>
        <!-- 左面 (x=-0.5) -->
        <triangle v0="-0.5,-0.25,-0.6" v1="-0.5,-0.25,0.6" v2="-0.5,0.25,0.6"/>
        <triangle v0="-0.5,-0.25,-0.6" v1="-0.5,0.25,0.6" v2="-0.5,0.25,-0.6"/>
        <!-- 右面 (x=0.5) -->
        <triangle v0="0.5,-0.25,0.6" v1="0.5,-0.25,-0.6" v2="0.5,0.25,-0.6"/>
        <triangle v0="0.5,-0.25,0.6" v1="0.5,0.25,-0.6" v2="0.5,0.25,0.6"/>
        <!-- 顶面 (y=0.25) -->
        <triangle v0="-0.5,0.25,0.6" v1="0.5,0.25,0.6" v2="0.5,0.25,-0.6"/>
        <triangle v0="-0.5,0.25,0.6" v1="0.5,0.25,-0.6" v2="-0.5,0.25,-0.6"/>
        <!-- 底面 (y=-0.25) -->
        <triangle v0="-0.5,-0.25,-0.6" v1="0.5,-0.25,-0.6" v2="0.5,-0.25,0.6"/>
        <triangle v0="-0.5,-0.25,-0.6" v1="0.5,-0.25,0.6" v2="-0.5,-0.25,0.6"/>
    </sceneobject>

    <!-- ==================== 车轮 (4个球体) ==================== -->
    <sceneobject position="-0.65,0.25,3.8" euler="0,0,0" scale="1.0">
        <sphere radius="0.25"/>
    </sceneobject>
    <sceneobject position="0.65,0.25,3.8" euler="0,0,0" scale="1.0">
        <sphere radius="0.25"/>
    </sceneobject>
    <sceneobject position="-0.65,0.25,2.2" euler="0,0,0" scale="1.0">
        <sphere radius="0.25"/>
    </sceneobject>
    <sceneobject position="0.65,0.25,2.2" euler="0,0,0" scale="1.0">
        <sphere radius="0.25"/>
    </sceneobject>

    <!-- ==================== 车灯 (2个小球体) ==================== -->
    <sceneobject position="-0.4,0.7,4.2" euler="0,0,0" scale="1.0">
        <sphere radius="0.08"/>
    </sceneobject>
    <sceneobject position="0.4,0.7,4.2" euler="0,0,0" scale="1.0">
        <sphere radius="0.08"/>
    </sceneobject>

    <!-- ==================== 路边树 A (四棱锥) ==================== -->
    <sceneobject position="-3,0,2" euler="0,0,0" scale="1.0">
        <triangle v0="0,2,0" v1="-0.6,0,-0.6" v2="0.6,0,-0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,-0.6" v2="0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,0.6" v2="-0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="-0.6,0,0.6" v2="-0.6,0,-0.6"/>
    </sceneobject>

    <!-- ==================== 路边树 B ==================== -->
    <sceneobject position="3,0,5" euler="0,0,0" scale="1.0">
        <triangle v0="0,2,0" v1="-0.6,0,-0.6" v2="0.6,0,-0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,-0.6" v2="0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,0.6" v2="-0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="-0.6,0,0.6" v2="-0.6,0,-0.6"/>
    </sceneobject>

    <!-- ==================== 路边树 C (远处) ==================== -->
    <sceneobject position="-3,0,6" euler="0,0,0" scale="1.2">
        <triangle v0="0,2,0" v1="-0.6,0,-0.6" v2="0.6,0,-0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,-0.6" v2="0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="0.6,0,0.6" v2="-0.6,0,0.6"/>
        <triangle v0="0,2,0" v1="-0.6,0,0.6" v2="-0.6,0,-0.6"/>
    </sceneobject>
</scene>
